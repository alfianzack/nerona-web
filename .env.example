# Layanan AI SumoPod (agent + metadata). Beda produk, beda kunci, dari vendor
# yang sama dengan pembayaran di bawah — jangan tertukar.
SUMOPOD_API_KEY=""
SUMOPOD_BASE_URL="https://ai.sumopod.com/v1"

# SumoPod Managed Payment (QRIS). Kosongkan untuk mematikan pembayaran QRIS;
# pelanggan otomatis jatuh ke transfer manual. Sandbox vs live ditentukan
# pasangan base URL + kunci, jadi keduanya harus berpindah bersama.
SUMOPOD_PAY_API_BASE="https://api-pay-sandbox.sumopod.com"
SUMOPOD_PAY_API_KEY=""
SUMOPOD_PAY_WEBHOOK_SECRET=""
# Cadangan, dipakai HANYA kalau pengirim tidak menyertakan header tanda tangan
# sama sekali. Lebih lemah: string tetap tanpa timestamp dan tidak terikat isi
# badan, jadi siapa pun yang memilikinya bisa mengarang payment.completed untuk
# order mana pun. Biarkan kosong selama tanda tangannya bekerja.
SUMOPOD_PAY_WEBHOOK_TOKEN=""
AGENT_MODEL="claude-sonnet-4-6"
CRON_SECRET="generate-with-openssl-rand-base64-32"
WHATSAPP_DISPLAY_NUMBER="+1 555 123 4567"
