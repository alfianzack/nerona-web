{
  "apps": [
    {
      "name": "nerona",
      "cwd": "/var/www/nerona-web",
      "script": "./node_modules/next/dist/bin/next",
      "args": "start -p 3000",
      "exec_mode": "fork",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "600M",
      "min_uptime": "20s",
      "max_restarts": 10,
      "restart_delay": 3000,
      "kill_timeout": 10000,
      "time": true,
      "out_file": "./logs/nerona-out.log",
      "error_file": "./logs/nerona-error.log",
      "env": {
        "NODE_ENV": "production",
        "PORT": "3000"
      }
    }
  ]
}
